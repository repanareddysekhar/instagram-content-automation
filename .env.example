# Runtime
APP_ENV=development
APP_BASE_URL=http://localhost:8000
DATABASE_PATH=data/agent.db
AUTO_PUBLISH=false
MOCK_MODE=true
ADMIN_TOKEN=change-me

# OpenAI
OPENAI_API_KEY=
