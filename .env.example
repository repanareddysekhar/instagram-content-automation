# Runtime
APP_ENV=development
APP_BASE_URL=http://localhost:8000
DATABASE_PATH=data/agent.db
AUTO_PUBLISH=false
MOCK_MODE=true
ADMIN_TOKEN=change-me

# AI provider: gemini, anthropic, openai, or openai_compatible
TEXT_PROVIDER=gemini
AI_REQUEST_TIMEOUT_SECONDS=90

# Google Gemini (default; AI Studio has a free tier)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_IMAGE_BASE_URL=https://generativelanguage.googleapis.com/v1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-haiku-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# OpenAI
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2

# OpenAI-compatible APIs (OpenRouter, Groq, Together, Ollama, and similar)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_TEXT_MODEL=
OPENAI_COMPATIBLE_BASE_URL=

# Optional generated backgrounds; deterministic carousel art needs no AI image API
IMAGE_PROVIDER=none
ENABLE_AI_ART=false

# Telegram approval
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=change-me-too

# Instagram API (use the current Graph API version configured in your Meta app)
META_GRAPH_BASE_URL=https://graph.instagram.com
META_GRAPH_API_VERSION=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_INSIGHT_METRICS=views,reach,likes,comments,saves,shares,total_interactions
